{
  "name": "@seed-ship/mcp-ui-solid",
  "version": "1.2.0",
  "description": "SolidJS components for rendering MCP-generated UI resources",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "solid": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./components": {
      "types": "./dist/components.d.ts",
      "solid": "./src/components/index.ts",
      "import": "./dist/components.js",
      "require": "./dist/components.cjs"
    },
    "./hooks": {
      "types": "./dist/hooks.d.ts",
      "solid": "./src/hooks/index.ts",
      "import": "./dist/hooks.js",
      "require": "./dist/hooks.cjs"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "solid": "./src/types/index.ts",
      "import": "./dist/types.js",
      "require": "./dist/types.cjs"
    },
    "./validation": {
      "types": "./dist/validation.d.ts",
      "solid": "./src/validation.ts",
      "import": "./dist/validation.js",
      "require": "./dist/validation.cjs"
    },
    "./types-only": {
      "types": "./dist/types-export.d.ts",
      "solid": "./src/types-export.ts",
      "import": "./dist/types-export.js",
      "require": "./dist/types-export.cjs"
    },
    "./src/*": "./src/*"
  },
  "scripts": {
    "build": "vite build && pnpm build:types",
    "build:types": "tsc --declaration --emitDeclarationOnly --outDir dist --composite false && cp dist/components/index.d.ts dist/components.d.ts 2>/dev/null || true && cp dist/hooks/index.d.ts dist/hooks.d.ts 2>/dev/null || true && cp dist/types/index.d.ts dist/types.d.ts 2>/dev/null || true",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "vitest --mode browser",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "solid-js": "^1.9.0"
  },
  "dependencies": {
    "@types/dompurify": "^3.0.5",
    "dompurify": "^3.3.0",
    "marked": "^16.3.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@solidjs/testing-library": "^0.8.5",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "@vitest/ui": "^4.0.9",
    "eslint": "^8.56.0",
    "jsdom": "^27.2.0",
    "solid-js": "^1.9.10",
    "typescript": "^5.3.3",
    "vite": "^6.3.6",
    "vite-plugin-solid": "^2.11.8",
    "vitest": "^4.0.8"
  },
  "keywords": [
    "mcp",
    "ui",
    "solidjs",
    "components",
    "streaming",
    "dashboard",
    "generative-ui"
  ],
  "author": "Gabriel Brument",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/theseedship/mcp-ui.git",
    "directory": "mcp-ui-solid"
  },
  "homepage": "https://github.com/theseedship/mcp-ui#readme",
  "bugs": {
    "url": "https://github.com/theseedship/mcp-ui/issues"
  }
}
