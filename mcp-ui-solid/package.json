{
  "name": "@seed-ship/mcp-ui-solid",
  "version": "1.0.6",
  "description": "SolidJS components for rendering MCP-generated UI resources",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./components": {
      "import": "./dist/components/index.js",
      "require": "./dist/components/index.cjs",
      "types": "./dist/components/index.d.ts"
    },
    "./hooks": {
      "import": "./dist/hooks/index.js",
      "require": "./dist/hooks/index.cjs",
      "types": "./dist/hooks/index.d.ts"
    },
    "./types": {
      "import": "./dist/types/index.js",
      "require": "./dist/types/index.cjs",
      "types": "./dist/types/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "vite build && pnpm build:types",
    "build:types": "tsc --emitDeclarationOnly --outDir dist --skipLibCheck",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "vitest --mode browser",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "solid-js": "^1.9.0"
  },
  "dependencies": {
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@solidjs/testing-library": "^0.8.5",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "@vitest/ui": "^4.0.9",
    "eslint": "^8.56.0",
    "jsdom": "^27.2.0",
    "solid-js": "^1.9.10",
    "typescript": "^5.3.3",
    "vite": "^6.3.6",
    "vite-plugin-solid": "^2.11.8",
    "vitest": "^4.0.8"
  },
  "keywords": [
    "mcp",
    "ui",
    "solidjs",
    "components",
    "streaming",
    "dashboard",
    "generative-ui"
  ],
  "author": "Gabriel Brument",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/theseedship/mcp-ui.git",
    "directory": "mcp-ui-solid"
  },
  "homepage": "https://github.com/theseedship/mcp-ui#readme",
  "bugs": {
    "url": "https://github.com/theseedship/mcp-ui/issues"
  }
}
