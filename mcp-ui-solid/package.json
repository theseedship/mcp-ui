{
  "name": "@seed-ship/mcp-ui-solid",
  "version": "6.22.1",
  "description": "SolidJS components for rendering MCP-generated UI resources",
  "type": "module",
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/test-setup.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "components": [
        "./dist/components.d.ts"
      ],
      "hooks": [
        "./dist/hooks.d.ts"
      ],
      "types": [
        "./dist/types.d.ts"
      ],
      "validation": [
        "./dist/validation.d.ts"
      ],
      "types-only": [
        "./dist/types-export.d.ts"
      ],
      "adapters": [
        "./dist/adapters.d.ts"
      ],
      "adapters/presentation": [
        "./dist/adapters/presentation.d.ts"
      ],
      "plugins/duckdb": [
        "./dist/plugins/duckdb.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "solid": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./components": {
      "solid": "./src/components/index.ts",
      "import": {
        "types": "./dist/components.d.ts",
        "default": "./dist/components.js"
      },
      "require": {
        "types": "./dist/components.d.cts",
        "default": "./dist/components.cjs"
      }
    },
    "./hooks": {
      "solid": "./src/hooks/index.ts",
      "import": {
        "types": "./dist/hooks.d.ts",
        "default": "./dist/hooks.js"
      },
      "require": {
        "types": "./dist/hooks.d.cts",
        "default": "./dist/hooks.cjs"
      }
    },
    "./types": {
      "solid": "./src/types/index.ts",
      "import": {
        "types": "./dist/types.d.ts",
        "default": "./dist/types.js"
      },
      "require": {
        "types": "./dist/types.d.cts",
        "default": "./dist/types.cjs"
      }
    },
    "./validation": {
      "solid": "./src/validation.ts",
      "import": {
        "types": "./dist/validation.d.ts",
        "default": "./dist/validation.js"
      },
      "require": {
        "types": "./dist/validation.d.cts",
        "default": "./dist/validation.cjs"
      }
    },
    "./types-only": {
      "solid": "./src/types-export.ts",
      "import": {
        "types": "./dist/types-export.d.ts",
        "default": "./dist/types-export.js"
      },
      "require": {
        "types": "./dist/types-export.d.cts",
        "default": "./dist/types-export.cjs"
      }
    },
    "./adapters": {
      "solid": "./src/adapters/index.ts",
      "import": {
        "types": "./dist/adapters.d.ts",
        "default": "./dist/adapters.js"
      },
      "require": {
        "types": "./dist/adapters.d.cts",
        "default": "./dist/adapters.cjs"
      }
    },
    "./adapters/presentation": {
      "solid": "./src/adapters/presentation.ts",
      "import": {
        "types": "./dist/adapters/presentation.d.ts",
        "default": "./dist/adapters/presentation.js"
      },
      "require": {
        "types": "./dist/adapters/presentation.d.cts",
        "default": "./dist/adapters/presentation.cjs"
      }
    },
    "./plugins/duckdb": {
      "solid": "./src/plugins/duckdb.ts",
      "import": {
        "types": "./dist/plugins/duckdb.d.ts",
        "default": "./dist/plugins/duckdb.js"
      },
      "require": {
        "types": "./dist/plugins/duckdb.d.cts",
        "default": "./dist/plugins/duckdb.cjs"
      }
    },
    "./src/*": "./src/*"
  },
  "scripts": {
    "build": "vite build && pnpm build:types",
    "build:types": "tsc --declaration --emitDeclarationOnly --outDir dist --composite false && pnpm build:types:copy",
    "build:types:copy": "printf \"export * from './components/index';\\nexport { default } from './components/index';\\n\" > dist/components.d.ts && printf \"export * from './hooks/index';\\n\" > dist/hooks.d.ts && printf \"export * from './types/index';\\n\" > dist/types.d.ts && printf \"export * from './adapters/index';\\n\" > dist/adapters.d.ts && pnpm build:types:cts",
    "build:types:cts": "cp dist/index.d.ts dist/index.d.cts && cp dist/components.d.ts dist/components.d.cts 2>/dev/null || true && cp dist/hooks.d.ts dist/hooks.d.cts 2>/dev/null || true && cp dist/types.d.ts dist/types.d.cts 2>/dev/null || true && cp dist/validation.d.ts dist/validation.d.cts 2>/dev/null || true && cp dist/types-export.d.ts dist/types-export.d.cts 2>/dev/null || true && cp dist/adapters.d.ts dist/adapters.d.cts 2>/dev/null || true && cp dist/adapters/presentation.d.ts dist/adapters/presentation.d.cts 2>/dev/null || true && cp dist/plugins/duckdb.d.ts dist/plugins/duckdb.d.cts 2>/dev/null || true",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "vitest --mode browser",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.contracts.json",
    "clean": "rm -rf dist",
    "size": "size-limit",
    "size:analyze": "size-limit --why"
  },
  "_size-limit-note": "size-limit is a regression guardrail, not a hard cap — it flags accidental bundle bloat. It measures the pre-built dist/index.js and sums the FULL graph reachable from each entry, including lazy import() chunks (leaflet, @antv/g6, chart.js) a consumer fetches on demand, NOT at import time — so the figures are worst-case totals, not eager load cost. Since v6.6.0 the 'Streaming renderer' entry delegates to UIResourceRenderer (Gap 1 parity), so its graph equals the full renderer set; its budget is set to 1 MB (generous headroom — the real eager cost is far lower). The 'Hooks only' and 'Full bundle' limits are pre-existing and unchanged by v6.6.0. size-limit is informational only — it does not gate CI.",
  "size-limit": [
    {
      "name": "Streaming renderer",
      "path": "dist/index.js",
      "import": "{ StreamingUIRenderer }",
      "limit": "1 MB"
    },
    {
      "name": "Hooks only",
      "path": "dist/index.js",
      "import": "{ useStreamingUI, useAction }",
      "limit": "25 KB"
    },
    {
      "name": "Full bundle (with deps)",
      "path": "dist/index.js",
      "limit": "350 KB"
    }
  ],
  "peerDependencies": {
    "@antv/g6": "^5.0.0",
    "@duckdb/duckdb-wasm": "^1.28.0",
    "@tanstack/solid-virtual": "^3.0.0",
    "chart.js": "^4.0.0",
    "chartjs-plugin-zoom": "^2.0.0",
    "highlight.js": "^11.9.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.0",
    "protomaps-leaflet": "^4.0.0",
    "solid-js": "^1.9.0"
  },
  "peerDependenciesMeta": {
    "@antv/g6": {
      "optional": true
    },
    "@duckdb/duckdb-wasm": {
      "optional": true
    },
    "chart.js": {
      "optional": true
    },
    "chartjs-plugin-zoom": {
      "optional": true
    },
    "highlight.js": {
      "optional": true
    },
    "leaflet": {
      "optional": true
    },
    "leaflet.markercluster": {
      "optional": true
    },
    "@tanstack/solid-virtual": {
      "optional": true
    },
    "protomaps-leaflet": {
      "optional": true
    }
  },
  "dependencies": {
    "@seed-ship/mcp-ui-spec": "workspace:^5.6.0",
    "@types/dompurify": "^3.0.5",
    "dompurify": "^3.4.12",
    "marked": "^16.3.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@size-limit/esbuild": "^12.0.0",
    "@size-limit/esbuild-why": "^12.0.0",
    "@size-limit/preset-small-lib": "^12.0.0",
    "@solidjs/testing-library": "^0.8.5",
    "@tanstack/solid-virtual": "^3.13.18",
    "@types/leaflet": "^1.9.8",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "@vitest/ui": "^4.1.11",
    "chart.js": "^4.5.1",
    "eslint": "^8.56.0",
    "jsdom": "^27.2.0",
    "leaflet.markercluster": "^1.5.3",
    "size-limit": "^12.0.0",
    "solid-js": "^1.9.11",
    "typescript": "^5.3.3",
    "vite": "^6.4.1",
    "vite-plugin-solid": "^2.11.8",
    "vitest": "^4.1.11"
  },
  "keywords": [
    "mcp",
    "ui",
    "solidjs",
    "components",
    "streaming",
    "dashboard",
    "generative-ui"
  ],
  "author": "Nicolas GEYSSE",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theseedship/mcp-ui.git",
    "directory": "mcp-ui-solid"
  },
  "homepage": "https://github.com/theseedship/mcp-ui#readme",
  "bugs": {
    "url": "https://github.com/theseedship/mcp-ui/issues"
  }
}
