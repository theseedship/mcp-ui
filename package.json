{
  "name": "@mcp-ui/root",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "MCP UI Components - Monorepo root",
  "repository": {
    "type": "git",
    "url": "https://github.com/theseedship/mcp-ui.git"
  },
  "author": "Nicolas GEYSSE",
  "license": "MIT",
  "scripts": {
    "build": "pnpm -r build",
    "build:spec": "pnpm --filter @mcp-ui/spec build",
    "build:cli": "pnpm --filter @mcp-ui/cli build",
    "build:solid": "pnpm --filter @mcp-ui/solid build",
    "dev": "pnpm -r --parallel dev",
    "test": "pnpm -r test",
    "test:watch": "pnpm -r --parallel test:watch",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r clean && rm -rf node_modules",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "publish:all": "pnpm -r publish --access public",
    "publish:dry": "pnpm -r publish --access public --dry-run",
    "version:patch": "pnpm -r exec -- npm version patch",
    "version:minor": "pnpm -r exec -- npm version minor",
    "version:major": "pnpm -r exec -- npm version major"
  },
  "devDependencies": {
    "@eslint/js": "^8.56.0",
    "prettier": "^3.1.1",
    "typescript": "^5.3.3",
    "typescript-eslint": "^7.0.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0",
  "pnpm": {
    "overrides": {
      "lodash": ">=4.17.23",
      "@isaacs/brace-expansion": ">=5.0.1",
      "minimatch": ">=10.2.1",
      "postcss": ">=8.5.10",
      "fast-uri": ">=3.1.2"
    }
  }
}
