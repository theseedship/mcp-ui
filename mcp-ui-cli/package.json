{
  "name": "@seed-ship/mcp-ui-cli",
  "version": "5.0.2",
  "description": "CLI tools for validating and generating MCP UI component registries",
  "type": "module",
  "bin": {
    "mcp-ui": "./dist/cli.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build && pnpm build:types",
    "build:types": "tsc --emitDeclarationOnly --outDir dist --composite false && node ../scripts/finalize-declarations.mjs dist",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@seed-ship/mcp-ui-spec": "workspace:^6.0.0",
    "ajv": "^8.18.0",
    "ajv-formats": "3.0.1",
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "json-schema-to-typescript": "^15.0.4",
    "ora": "^7.0.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "typescript": "^5.3.3",
    "vite": "6.4.5",
    "vitest": "4.1.12"
  },
  "keywords": [
    "mcp",
    "ui",
    "cli",
    "validation",
    "codegen",
    "component-registry"
  ],
  "author": "Nicolas GEYSSE",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/theseedship/mcp-ui.git",
    "directory": "mcp-ui-cli"
  },
  "homepage": "https://github.com/theseedship/mcp-ui#readme",
  "bugs": {
    "url": "https://github.com/theseedship/mcp-ui/issues"
  }
}
