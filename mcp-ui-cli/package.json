{
  "name": "@seed-ship/mcp-ui-cli",
  "version": "1.0.6",
  "description": "CLI tools for validating and generating MCP UI component registries",
  "type": "module",
  "bin": {
    "mcp-ui": "./dist/cli.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "vite build",
    "build:types": "tsc --emitDeclarationOnly --outDir dist",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@seed-ship/mcp-ui-spec": "workspace:*",
    "ajv": "^8.12.0",
    "commander": "^11.1.0",
    "json-schema-to-typescript": "^13.1.1",
    "zod": "^3.22.4",
    "chalk": "^5.3.0",
    "ora": "^7.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.10",
    "vitest": "^1.1.0"
  },
  "keywords": [
    "mcp",
    "ui",
    "cli",
    "validation",
    "codegen",
    "component-registry"
  ],
  "author": "Gabriel Brument",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/theseedship/mcp-ui.git",
    "directory": "mcp-ui-cli"
  },
  "homepage": "https://github.com/theseedship/mcp-ui#readme",
  "bugs": {
    "url": "https://github.com/theseedship/mcp-ui/issues"
  }
}
