{
  "name": "@seed-ship/mcp-ui-spec",
  "version": "6.0.0",
  "description": "Component registry specification and JSON Schemas for MCP UI",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    },
    "./schemas": {
      "import": { "types": "./dist/schemas/index.d.ts", "default": "./dist/schemas.js" },
      "require": { "types": "./dist/schemas/index.d.cts", "default": "./dist/schemas.cjs" }
    },
    "./schemas/component-registry-v1.json": "./schemas/component-registry-v1.json"
  },
  "files": [
    "dist",
    "schemas",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json --outDir dist && node ../scripts/finalize-declarations.mjs dist",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.contracts.json",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "typescript": "^5.3.3",
    "vite": "6.4.5",
    "vitest": "4.1.12"
  },
  "keywords": [
    "mcp",
    "ui",
    "specification",
    "json-schema",
    "component-registry"
  ],
  "author": "Nicolas GEYSSE",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/theseedship/mcp-ui.git",
    "directory": "mcp-ui-spec"
  },
  "homepage": "https://github.com/theseedship/mcp-ui#readme",
  "bugs": {
    "url": "https://github.com/theseedship/mcp-ui/issues"
  }
}
